{
  "schema": "durable-workflow.sdk-rust.bounded-qualification/v1",
  "budget_seconds": 150,
  "job_timeout_minutes": 3,
  "checks": [
    {
      "id": "manifest",
      "command": ["cargo", "metadata", "--no-deps", "--format-version", "1"],
      "quiet_stdout": true
    },
    {
      "id": "rustfmt",
      "command": ["cargo", "fmt", "--all", "--check"]
    },
    {
      "id": "diff-boundary",
      "command": ["git", "diff", "--check", "{candidate_range}"]
    },
    {
      "id": "public-boundary",
      "command": ["scripts/check-public-boundary.sh"]
    },
    {
      "id": "compile",
      "command": ["cargo", "check", "--all-targets"]
    }
  ],
  "complete_checks": [
    "msrv-all-target-tests",
    "stable-all-target-tests",
    "typed-avro-compatibility",
    "typed-avro-regression-budget",
    "warning-free-rustdoc",
    "publishable-package-content",
    "release-tooling"
  ]
}
